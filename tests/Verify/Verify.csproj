<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A runner for the same checks with no NuGet dependency at all.

    `dotnet test` needs xunit and the VSTest host from NuGet. On a machine with
    no package feed that is unrunnable, and "the tests cannot be restored" is
    too easily read as "the tests pass". This project references nothing but
    the SDK, so `dotnet run` verifies the identical assertions offline.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Chatly.Verify</AssemblyName>
    <RootNamespace>Chatly.Verify</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Chatly/Chatly.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Checks/*.cs" LinkBase="Checks" />
  </ItemGroup>

</Project>
